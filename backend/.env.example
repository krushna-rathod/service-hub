# =============================================================================
# Service Hub - Backend Environment Variables Configuration
# =============================================================================
# Copy this file to .env and customize the values for your local environment:
#   cp .env.example .env

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
SITE_URL=http://localhost:5173
FORCE_HTTPS=false
JSON_BODY_LIMIT=7mb

# Database Configuration (MongoDB)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=service_hub
MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_IDLE_TIME_MS=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000

# Authentication (JWT Secret - at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Rate Limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
PASSWORD_RECOVERY_RATE_LIMIT_WINDOW_MS=600000
PASSWORD_RECOVERY_RATE_LIMIT_MAX=10

# Email Service (Brevo / SMTP)
APP_NAME=ServiceHub
SUPPORT_EMAIL=support@example.com
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME="Service Hub"
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_KEY=your_brevo_smtp_key
BREVO_API_KEY=your_brevo_api_key

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# SMS OTP Verification (Twilio Verify)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# WhatsApp Notifications & OTP (Twilio WhatsApp Sandbox or Meta WhatsApp Cloud API)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_OTP_CONTENT_SID=

# Meta WhatsApp Cloud API (Alternative)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# Redis Cache & Socket Adapter (Optional - falls back to in-memory)
REDIS_URL=
REDIS_CONNECT_TIMEOUT_MS=1500
REDIS_RETRY_COOLDOWN_MS=60000

# Server Maintenance & Timeouts
RUN_STARTUP_MAINTENANCE=false
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
SERVER_REQUEST_TIMEOUT_MS=30000
